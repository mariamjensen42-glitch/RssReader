{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rust RSS Reader",
  "version": "0.1.0",
  "identifier": "com.cycling.rustrssreader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rust RSS Reader",
        "width": 1200,
        "height": 700,
        "minWidth": 992,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "backgroundColor": "#181818",
        "windowEffects": {
          "effects": ["mica"]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
